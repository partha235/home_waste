#  for controlling servo-180
from machine import Pin, PWM
import time

# Define servo PWM objects (GPIO pins must support PWM)
lid_servo = PWM(Pin(14), freq=50)    # Main lid servo
sensor_servo = PWM(Pin(26), freq=50) # Sensor mover servo

# Function to set angle for a given servo
def set_angle(servo, angle):
    # Convert angle (0–180°) to duty cycle
    min_duty = 26   # ~0.5 ms pulse width
    max_duty = 128  # ~2.5 ms pulse width
    duty = int(min_duty + (angle / 180) * (max_duty - min_duty))
    servo.duty(duty)

# Example usage loop
while True:
    # print("Lid Servo: Moving to 160° (closed)")
    # set_angle(lid_servo, 160)
    
    print("Sensor Servo: Moving to 90° (down)")
    set_angle(sensor_servo, 90)

    time.sleep(5)

    # print("Lid Servo: Moving to 70° (open)")
    # set_angle(lid_servo, 70)

    print("Sensor Servo: Moving to 40° (up)")
    set_angle(sensor_servo,40)

    time.sleep(5)
